<UserControl x:Class="TheMovies.Views.ScreeningView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        IsVisibleChanged="ScreeningView_IsVisibleChanged"
        MinHeight="550">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <TextBlock Text="Forestillinger"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Planlæg filmvisninger i biografernes sale."
                       Style="{StaticResource PageDescriptionStyle}"/>

            <TextBlock Text="Film:"/>

            <ComboBox ItemsSource="{Binding MovieList}"
                      SelectedItem="{Binding SelectedMovie}"
                      DisplayMemberPath="Titel"
                      Margin="0,0,0,15"/>


            <TextBlock Text="Biograf:"/>

            <ComboBox ItemsSource="{Binding CinemaList}"
                      SelectedItem="{Binding SelectedCinema}"
                      DisplayMemberPath="Navn"
                      Margin="0,0,0,15"/>


            <TextBlock Text="Sal:"/>

            <ComboBox ItemsSource="{Binding RoomList}"
                      SelectedItem="{Binding SelectedRoom}"
                      DisplayMemberPath="Nummer"
                      Margin="0,0,0,15"/>


            <TextBlock Text="Dato:"/>

            <DatePicker SelectedDate="{Binding Dato}"
                        Margin="0,0,0,15"/>


            <TextBlock Text="Starttidspunkt:"/>

            <TextBox Text="{Binding TidInput, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,15"/>

            <TextBlock Text="{Binding BeregnetSluttid}"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,0,0,15"/>


            <Button Content="Registrer forestilling"
                    Command="{Binding RegistrerCommand}"
                    Width="160"
                    Height="35"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,20"/>

            <TextBlock Text="{Binding Fejlbesked}" Foreground="#C62828"/>
            <TextBlock Text="{Binding Succesbesked}" Foreground="#287A3D" Margin="0,4,0,8"/>


            <TextBlock Text="Registrerede forestillinger"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBox Text="{Binding SoegeTekst, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Søg efter film eller biograf"/>


            <DataGrid ItemsSource="{Binding ScreeningView}"
                      SelectedItem="{Binding SelectedScreening}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      MinHeight="210">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Film" Binding="{Binding Film.Titel}" Width="2*"/>
                    <DataGridTextColumn Header="Biograf" Binding="{Binding Biograf.Navn}" Width="*"/>
                    <DataGridTextColumn Header="Sal" Binding="{Binding Sal.Nummer}" Width="Auto"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartTidspunkt, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                    <DataGridTextColumn Header="Slut" Binding="{Binding SlutTidspunkt, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Slet valgt forestilling"
                    Command="{Binding SletCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="180"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,8"/>

            <TextBlock Text="Ingen forestillinger er oprettet endnu. Opret først en film, biograf og sal.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding ScreeningList.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>

    </ScrollViewer>

</UserControl>
