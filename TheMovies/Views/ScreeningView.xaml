<UserControl x:Class="TheMovies.Views.ScreeningView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="550">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <TextBlock Text="Film:"/>

            <ComboBox ItemsSource="{Binding MovieList}"
                      SelectedItem="{Binding SelectedMovie}"
                      DisplayMemberPath="Titel"
                      Margin="0,0,0,15"/>


            <TextBlock Text="Biograf:"/>

            <ComboBox ItemsSource="{Binding CinemaList}"
                      SelectedItem="{Binding SelectedCinema}"
                      DisplayMemberPath="Navn"
                      Margin="0,0,0,15"/>


            <TextBlock Text="Sal:"/>

            <ComboBox ItemsSource="{Binding RoomList}"
                      SelectedItem="{Binding SelectedRoom}"
                      DisplayMemberPath="Nummer"
                      Margin="0,0,0,15"/>


            <TextBlock Text="Dato:"/>

            <DatePicker SelectedDate="{Binding StartTidspunkt}"
                        Margin="0,0,0,15"/>


            <TextBlock Text="Starttidspunkt:"/>

            <TextBox Text="{Binding StartTidspunkt, StringFormat=HH:mm}"
                     Margin="0,0,0,15"/>


            <Button Content="Registrer forestilling"
                    Command="{Binding RegistrerCommand}"
                    Width="160"
                    Height="35"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,20"/>


            <TextBlock Text="Registrerede forestillinger:"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="0,0,0,5"/>


            <ListBox ItemsSource="{Binding ScreeningList}"
                     Height="180">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Margin="5">

                            <TextBlock Text="{Binding Film.Titel}"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Biograf.Navn,
                                                      StringFormat='Biograf: {0}'}"/>

                            <TextBlock Text="{Binding Sal.Nummer,
                                                      StringFormat='Sal {0}'}"/>

                            <TextBlock Text="{Binding StartTidspunkt,
                                                      StringFormat='Start: {0:dd/MM/yyyy HH:mm}'}"/>

                            <TextBlock Text="{Binding SlutTidspunkt,
                                                      StringFormat='Slut: {0:dd/MM/yyyy HH:mm}'}"/>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </StackPanel>

    </ScrollViewer>

</UserControl>
