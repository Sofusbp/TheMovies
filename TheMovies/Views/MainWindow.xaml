<Window x:Class="TheMovies.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheMovies"
        xmlns:views="clr-namespace:TheMovies.Views"
        mc:Ignorable="d"
        Title="The Movies"
        Height="720"
        Width="1000"
        MinHeight="600"
        MinWidth="850">

    <TabControl>

        <TabItem Header="Film">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="10">

            <!-- Titel -->
            <TextBlock TextWrapping="Wrap"
                       Text="Titel:"/>

            <Grid>
                <TextBox Text="{Binding Titel, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding FejlTitel}"
                           Foreground="Red"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FejlTitel}"
                                             Value="Titel må ikke være tom">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>
            </Grid>


            <!-- Varighed -->
            <TextBlock TextWrapping="Wrap"
                       Text="Varighed i min.:"/>

            <Grid>
                <TextBox Text="{Binding VarighedInput, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding FejlVarighed}"
                           Foreground="Red"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding FejlVarighed}"
                                             Value="Varighed må ikke være tom">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding FejlVarighed}"
                                             Value="Varighed skal være et tal">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding FejlVarighed}"
                                             Value="Varighed skal være større end 0">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>
            </Grid>


            <!-- Genre -->
            <TextBlock TextWrapping="Wrap"
                       Text="Genre:"/>

            <Grid>
                <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding FejlGenre}"
                           Foreground="Red"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding FejlGenre}"
                                             Value="Genre må ikke være tom">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>
            </Grid>


            <!-- Instruktør -->
            <TextBlock TextWrapping="Wrap"
                       Text="Instruktør:"/>

            <TextBox Text="{Binding Instruktøer, UpdateSourceTrigger=PropertyChanged}"/>


            <!-- Premieredato -->
            <TextBlock TextWrapping="Wrap"
                       Text="Premieredato:"/>

            <DatePicker SelectedDate="{Binding Premieredato, UpdateSourceTrigger=PropertyChanged}"/>


            <!-- Registrer -->
            <Button Content="Registrer"
                    Command="{Binding RegistrerCommand}"
                    Height="39"
                    Width="102"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,15"/>
            
            <!-- Liste -->
            <TextBlock Text="Registrerede film:"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <ListBox ItemsSource="{Binding MovieList}"
                     SelectedItem="{Binding SelectedMovie}"
                     Height="150">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Margin="5">

                            <TextBlock Text="{Binding Titel}"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Varighed}"/>

                            <TextBlock Text="{Binding Genre}"/>

                            <TextBlock Text="{Binding Instruktøer}"/>

                            <TextBlock Text="{Binding Premieredato, StringFormat=d}"/>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>


            <!-- Slet -->
            <Button Content="Slet"
                    Command="{Binding SletCommand}"
                    Height="38"
                    Width="102"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,10"/>

        </StackPanel>

    </ScrollViewer>

        </TabItem>

        <TabItem Header="Biografer og sale">
            <views:CinemaView/>
        </TabItem>

        <TabItem Header="Forestillinger">
            <views:ScreeningView/>
        </TabItem>

        <TabItem Header="Reservationer">
            <views:ReservationView/>
        </TabItem>

    </TabControl>

</Window>
