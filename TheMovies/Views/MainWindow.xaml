<Window x:Class="TheMovies.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheMovies"
        xmlns:views="clr-namespace:TheMovies.Views"
        mc:Ignorable="d"
        Title="The Movies"
        Height="720"
        Width="1000"
        MinHeight="600"
        MinWidth="850">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#182033" Padding="24,14">
            <StackPanel>
                <TextBlock Text="THE MOVIES" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Administration af biografer, forestillinger og reservationer" Foreground="#C8D1E3"/>
            </StackPanel>
        </Border>

    <TabControl Grid.Row="1" TabStripPlacement="Left">

        <TabItem Header="Film">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">

        <StackPanel Margin="28"
                    HorizontalAlignment="Stretch">

            <TextBlock Text="Film"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Opret og administrer film i biografens katalog."
                       Style="{StaticResource PageDescriptionStyle}"/>

            <!-- Titel -->
            <TextBlock TextWrapping="Wrap"
                       Text="Titel:"/>

            <Grid>
                <TextBox Text="{Binding Titel, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding FejlTitel}"
                           Foreground="Red"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FejlTitel}"
                                             Value="Titel må ikke være tom">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>
            </Grid>


            <!-- Varighed -->
            <TextBlock TextWrapping="Wrap"
                       Text="Varighed i min.:"/>

            <Grid>
                <TextBox Text="{Binding VarighedInput, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding FejlVarighed}"
                           Foreground="Red"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding FejlVarighed}"
                                             Value="Varighed må ikke være tom">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding FejlVarighed}"
                                             Value="Varighed skal være et tal">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding FejlVarighed}"
                                             Value="Varighed skal være større end 0">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>
            </Grid>


            <!-- Genre -->
            <TextBlock TextWrapping="Wrap"
                       Text="Genre:"/>

            <Grid>
                <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding FejlGenre}"
                           Foreground="Red"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding FejlGenre}"
                                             Value="Genre må ikke være tom">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>
            </Grid>


            <!-- Instruktør -->
            <TextBlock TextWrapping="Wrap"
                       Text="Instruktør:"/>

            <TextBox Text="{Binding Instruktøer, UpdateSourceTrigger=PropertyChanged}"/>


            <!-- Premieredato -->
            <TextBlock TextWrapping="Wrap"
                       Text="Premieredato:"/>

            <DatePicker SelectedDate="{Binding Premieredato, UpdateSourceTrigger=PropertyChanged}"/>


            <!-- Registrer -->
            <Button Content="Registrer"
                    Command="{Binding RegistrerCommand}"
                    Height="39"
                    Width="102"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,15"/>

            <Button Content="Gem ændringer"
                    Command="{Binding GemCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="140"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"/>

            <TextBlock Text="{Binding Succesbesked}"
                       Foreground="#287A3D"
                       Margin="0,0,0,10"/>
            
            <!-- Liste -->
            <TextBlock Text="Registrerede film"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBox Text="{Binding SoegeTekst, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Søg efter titel eller genre"/>

            <DataGrid ItemsSource="{Binding MovieView}"
                      SelectedItem="{Binding SelectedMovie}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      MinHeight="190">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Titel" Binding="{Binding Titel}" Width="2*"/>
                    <DataGridTextColumn Header="Varighed" Binding="{Binding Varighed, StringFormat={}{0} min.}" Width="*"/>
                    <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="*"/>
                    <DataGridTextColumn Header="Instruktør" Binding="{Binding Instruktøer}" Width="2*"/>
                    <DataGridTextColumn Header="Premiere" Binding="{Binding Premieredato, StringFormat=dd/MM/yyyy}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Ingen film er oprettet endnu. Udfyld formularen ovenfor for at komme i gang.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding MovieList.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>


            <!-- Slet -->
            <Button Content="Slet valgt film"
                    Command="{Binding SletCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Height="38"
                    Width="102"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,10"/>

        </StackPanel>

    </ScrollViewer>

        </TabItem>

        <TabItem Header="Biografer og sale"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">
            <views:CinemaView/>
        </TabItem>

        <TabItem Header="Forestillinger">
            <views:ScreeningView/>
        </TabItem>

        <TabItem Header="Reservationer">
            <views:ReservationView/>
        </TabItem>

    </TabControl>
    </Grid>

</Window>
