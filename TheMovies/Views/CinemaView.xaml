<UserControl x:Class="TheMovies.Views.CinemaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="500">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">

        <StackPanel Margin="20"
                    HorizontalAlignment="Stretch">

            <TextBlock Text="Biografer og sale"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Opret biografer og angiv kapaciteten i deres sale."
                       Style="{StaticResource PageDescriptionStyle}"/>

            <TextBlock Text="Biografnavn:"/>

            <TextBox Text="{Binding Navn, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <Button Content="Opret biograf"
                    Command="{Binding OpretBiografCommand}"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>

            <TextBlock Text="Biografer"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBlock Text="Vælg biograf:"/>

            <ComboBox ItemsSource="{Binding CinemaList}"
                      SelectedItem="{Binding SelectedCinema}"
                      DisplayMemberPath="Navn"/>

            <DataGrid ItemsSource="{Binding CinemaRoomList}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      MinHeight="190">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Biograf" Binding="{Binding BiografNavn}" Width="2*"/>
                    <DataGridTextColumn Header="Sal" Binding="{Binding SalNummer}" Width="*"/>
                    <DataGridTextColumn Header="Kapacitet" Binding="{Binding Kapacitet}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Slet valgt biograf"
                    Command="{Binding SletBiografCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="160"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,8"/>

            <TextBlock Text="Ingen biografer er oprettet endnu. Opret en biograf, før du tilføjer sale.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding CinemaList.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="Sal nummer:"
                       Margin="0,15,0,0"/>

            <TextBox Text="{Binding NummerInput, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Kapacitet:"/>

            <TextBox Text="{Binding KapacitetInput, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <Button Content="Opret sal"
                    Command="{Binding OpretSalCommand}"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding Fejlbesked}" Foreground="#C62828" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding Succesbesked}" Foreground="#287A3D" Margin="0,4,0,0"/>

        </StackPanel>

    </ScrollViewer>

</UserControl>
