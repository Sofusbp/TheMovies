<UserControl x:Class="TheMovies.Views.CinemaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="500">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <TextBlock Text="Biografer og sale"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Opret biografer og angiv kapaciteten i deres sale."
                       Style="{StaticResource PageDescriptionStyle}"/>

            <TextBlock Text="Biografnavn:"/>

            <TextBox Text="{Binding Navn, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <Button Content="Opret biograf"
                    Command="{Binding OpretBiografCommand}"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>

            <TextBlock Text="Biografer"
                       Style="{StaticResource SectionTitleStyle}"/>

            <ListBox ItemsSource="{Binding CinemaList}"
                     SelectedItem="{Binding SelectedCinema}"
                     Height="150">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Margin="5">

                            <TextBlock Text="{Binding Navn}"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Sale:"
                                       Margin="0,5,0,2"/>

                            <ItemsControl ItemsSource="{Binding Sale}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="{Binding Nummer,
                                                              StringFormat='Sal {0}'}"/>

                                            <TextBlock Text="{Binding Kapacitet,
                                                              StringFormat=' – kapacitet: {0}'}"/>

                                        </StackPanel>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

            <TextBlock Text="Sal nummer:"
                       Margin="0,15,0,0"/>

            <TextBox Text="{Binding NummerInput, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Kapacitet:"/>

            <TextBox Text="{Binding KapacitetInput, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <Button Content="Opret sal"
                    Command="{Binding OpretSalCommand}"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Center"/>

        </StackPanel>

    </ScrollViewer>

</UserControl>
