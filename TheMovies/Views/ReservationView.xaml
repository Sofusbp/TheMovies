<UserControl x:Class="TheMovies.Views.ReservationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="650">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <TextBlock Text="Reservationer"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Registrer kundens billetter til en valgt forestilling."
                       Style="{StaticResource PageDescriptionStyle}"/>

            <TextBlock Text="Forestilling:"/>

            <ComboBox ItemsSource="{Binding ScreeningList}"
                      SelectedItem="{Binding SelectedScreening}"
                      Margin="0,0,0,15">

                <ComboBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel>

                            <TextBlock Text="{Binding Film.Titel}" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Biograf.Navn,
                                                      StringFormat='{}{0}'}"/>
                            <TextBlock Text="{Binding Sal.Nummer,
                                                      StringFormat=' – sal {0}'}"/>
                            <TextBlock Text="{Binding StartTidspunkt,
                                                      StringFormat=' – {0:dd/MM/yyyy HH:mm}'}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LedigePladser,
                                                      StringFormat='Ledige pladser: {0}'}"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                        </StackPanel>

                    </DataTemplate>

                </ComboBox.ItemTemplate>

            </ComboBox>

            <TextBlock Text="Antal billetter:"/>

            <TextBox Text="{Binding AntalBilletterInput, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Email:"/>

            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Telefonnummer:"/>

            <TextBox Text="{Binding Telefonnummer, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="{Binding Fejlbesked}"
                       Foreground="Red"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding Succesbesked}"
                       Foreground="#287A3D"
                       Margin="0,0,0,10"/>

            <Button Content="Registrer reservation"
                    Command="{Binding RegistrerCommand}"
                    Width="170"
                    Height="35"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>

            <TextBlock Text="Registrerede reservationer"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBox Text="{Binding SoegeTekst, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Søg efter film, email eller telefon"/>

            <DataGrid ItemsSource="{Binding ReservationView}"
                      SelectedItem="{Binding SelectedReservation}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      MinHeight="230">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Film" Binding="{Binding Forestilling.Film.Titel}" Width="2*"/>
                    <DataGridTextColumn Header="Tid" Binding="{Binding Forestilling.StartTidspunkt, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                    <DataGridTextColumn Header="Biograf" Binding="{Binding Forestilling.Biograf.Navn}" Width="*"/>
                    <DataGridTextColumn Header="Sal" Binding="{Binding Forestilling.Sal.Nummer}" Width="Auto"/>
                    <DataGridTextColumn Header="Billetter" Binding="{Binding AntalBilletter}" Width="Auto"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                    <DataGridTextColumn Header="Telefon" Binding="{Binding Telefonnummer}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Annuller valgt reservation"
                    Command="{Binding AnnullerCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="210"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,8"/>

            <TextBlock Text="Ingen reservationer endnu. Vælg en forestilling og registrer kundens billetter.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding ReservationList.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>

    </ScrollViewer>

</UserControl>
